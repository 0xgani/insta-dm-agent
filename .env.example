# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------
# API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Only for keys NOT scoped to a workspace (they start with sk-ant-usr-).
# Workspace ID from https://platform.claude.com/settings/workspaces (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
# claude-haiku-5-5 (cheap, fast) or claude-sonnet-5-5 (smarter). No code change needed.
CLAUDE_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# Instagram / Meta  (https://developers.facebook.com/apps -> your app)
# ---------------------------------------------------------------------------
# "facebook" = Instagram API with Facebook Login (Page token, graph.facebook.com)
# "instagram" = Instagram API with Instagram Login (IG user token, graph.instagram.com)
INSTAGRAM_AUTH_MODE=facebook
# facebook mode: a Page access token for the Page linked to your Instagram account.
#   Get a user token in Graph API Explorer with instagram_basic, instagram_manage_messages,
#   pages_manage_metadata, pages_read_engagement, pages_show_list, business_management,
#   then run: bun run scripts/exchange-token.ts <token>  (gives a never-expiring Page token)
# instagram mode: the token from App Dashboard -> Instagram -> API setup with Instagram login.
INSTAGRAM_ACCESS_TOKEN=
# facebook mode only: the Facebook Page ID (printed by scripts/exchange-token.ts)
FACEBOOK_PAGE_ID=
# Optional: your Instagram professional account ID. Learned from the first webhook if empty.
INSTAGRAM_ACCOUNT_ID=
# App Dashboard -> App settings -> Basic
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value into the webhook config in the Meta dashboard.
# Generate: openssl rand -base64 24
WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0

# ---------------------------------------------------------------------------
# Telegram (handoff notifications)
# ---------------------------------------------------------------------------
# Create a bot with @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Add the bot to a group (or DM it), send a message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id (groups are negative).
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# MCP server (claude.ai connector)
# ---------------------------------------------------------------------------
# Password for the connector login page, and a static bearer token for other MCP clients.
# Generate: openssl rand -base64 32
MCP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Public HTTPS URL that reaches PORT, e.g. a Cloudflare tunnel. No trailing slash.
PUBLIC_BASE_URL=
PORT=3000
DB_PATH=./data/bot.db
MEMORY_PATH=./MEMORY.md
# Initial cooldown only; seeds the settings table on first run. Change it later via MCP set_cooldown.
COOLDOWN_HOURS=6
# How long to wait for more messages before replying (ms).
DEBOUNCE_MS=4000
